<owl:Class rdf:about="#Ambulanza">
  <rdfs:subClassOf rdf:resource="#MezzoLeggero"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#puoGestire"/>
      <owl:someValuesFrom rdf:resource="#EmergenzaMedica"/>
