</owl:ObjectProperty>

<owl:Class rdf:about="#Luogo">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Nodo">
  <rdfs:subClassOf rdf:resource="#Luogo"/>
